{
  "name": "server",
  "version": "1.0.0",
  "description": "Server for Bomberman-clone multiplayer game",
  "main": "server.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:npc": "node server/npc/test-npc.js",
    "test:client": "vitest",
    "test:client:watch": "vitest --watch",
    "test:client:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "start": "cd server && nodemon server.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.11",
    "pino": "^10.1.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/jest": "^30.0.0",
    "@vitest/ui": "^3.2.4",
    "happy-dom": "^20.3.1",
    "jest": "^29.7.0",
    "jsdom": "^27.0.1",
    "playwright": "^1.57.0",
    "vitest": "^3.2.4"
  }
}
